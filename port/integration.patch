@@ -215,6 +215,14 @@ void ignition_can_hook(CANPacket_t *to_push) {
       ignition_can_cnt = 0U;
     }
 
+    // BYD exception (Yuan Plus / Atto 3)
+    if ((addr == 0x242) && (len == 8)) {
+      // DRIVE_STATE.GEAR (byte 5 low 3 bits): 1=P 2=R 3=N 4=D - only broadcast
+      // when the car is powered/ready, so any valid gear => ignition on.
+      ignition_can = (GET_BYTE(to_push, 5) & 0x07U) != 0U;
+      ignition_can_cnt = 0U;
+    }
+
   }
 }
 
diff --git a/panda/board/main.c b/panda/board/main.c
index 9770f836..4d65a5b9 100644
--- a/panda/board/main.c
+++ b/panda/board/main.c
@@ -113,6 +113,14 @@ void set_safety_mode(uint16_t mode, uint16_t param) {
         current_board->set_can_mode(CAN_MODE_NORMAL);
       }
       can_silent = ALL_CAN_LIVE;
+      // Atto3: the private radar bus (openpilot bus 1) is a READ-ONLY tap. Put its
+      // FDCAN in bus-monitoring mode (CCCR.MON via the can_silent path: no ACK, no
+      // error frames) so the panda can never disturb the Veoneer radar<->camera
+      // link. can_num 1 never flips (harness flip only swaps 0<->2), so bit 1 is
+      // always the middle bus. RX (incl. FD) is unaffected by MON.
+      if ((mode_copy == SAFETY_BYD) && ((param & 0x10U) != 0U)) {
+        can_silent |= (1U << 1);
+      }
       break;
   }
   can_init_all();
