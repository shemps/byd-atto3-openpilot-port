diff --git a/opendbc_repo/opendbc/can/dbc.py b/opendbc_repo/opendbc/can/dbc.py
index b85a70c4..688be687 100644
--- a/opendbc_repo/opendbc/can/dbc.py
+++ b/opendbc_repo/opendbc/can/dbc.py
@@ -16,6 +16,7 @@ from opendbc.car.volkswagen.mlbcan import volkswagen_mlb_checksum
 from opendbc.car.volkswagen.mqbcan import volkswagen_mqb_meb_checksum, volkswagen_mqb_meb_gen2_checksum, xor_checksum
 from opendbc.car.tesla.teslacan import tesla_checksum
 from opendbc.car.body.bodycan import body_checksum
+from opendbc.car.byd.bydcan import byd_checksum
 from opendbc.car.psa.psacan import psa_checksum
 
 
@@ -34,6 +35,7 @@ class SignalType:
   TESLA_CHECKSUM = 11
   PSA_CHECKSUM = 12
   VOLKSWAGEN_MLB_CHECKSUM = 13
+  BYD_CHECKSUM = 14
 
 
 @dataclass
@@ -201,6 +203,17 @@ def get_checksum_state(dbc_name: str) -> ChecksumState | None:
     return ChecksumState(8, 4, 7, 3, False, SignalType.BODY_CHECKSUM, body_checksum)
   elif dbc_name.startswith("tesla_model3_party"):
     return ChecksumState(8, -1, 0, -1, True, SignalType.TESLA_CHECKSUM, tesla_checksum, tesla_setup_signal)
+  elif dbc_name.startswith("byd_radar"):
+    # Veoneer private-bus radar: proprietary CRC8/SAE-J1850 + per-message DataID
+    # checksum, TWO per 64-byte frame (byte0 + byte32) - not expressible in
+    # opendbc's single-checksum-per-message model, and NOT the byd_ chassis 0xAF
+    # nibble (validated offline: private_checksum_validate.py, byd-can-bus). Without
+    # this branch the byd_ prefix wrongly applies byd_checksum -> every RADAR_TRACK
+    # frame fails checksum -> parser drops it (vl never updates) -> radar is dead.
+    # Trusted sensor on a silent MON tap; RadarInterface filters by conf+plausibility.
+    return None
+  elif dbc_name.startswith("byd_"):
+    return ChecksumState(8, 4, 56, 55, True, SignalType.BYD_CHECKSUM, byd_checksum)
   elif dbc_name.startswith("psa_"):
     return ChecksumState(4, 4, 7, 3, False, SignalType.PSA_CHECKSUM, psa_checksum)
   return None
